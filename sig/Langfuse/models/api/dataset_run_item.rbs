module Langfuse
  module Models
    module API
      type dataset_run_item =
        {
          id: String,
          created_at: Time,
          dataset_item_id: String,
          dataset_run_id: String,
          dataset_run_name: String,
          trace_id: String,
          updated_at: Time,
          observation_id: String?
        }

      class DatasetRunItem < Langfuse::BaseModel
        attr_accessor id: String

        attr_accessor created_at: Time

        attr_accessor dataset_item_id: String

        attr_accessor dataset_run_id: String

        attr_accessor dataset_run_name: String

        attr_accessor trace_id: String

        attr_accessor updated_at: Time

        attr_accessor observation_id: String?

        def initialize:
          (
            id: String,
            created_at: Time,
            dataset_item_id: String,
            dataset_run_id: String,
            dataset_run_name: String,
            trace_id: String,
            updated_at: Time,
            observation_id: String?
          ) -> void
          | (
            ?Langfuse::Models::API::dataset_run_item | Langfuse::BaseModel data
          ) -> void

        def to_hash: -> Langfuse::Models::API::dataset_run_item
      end
    end
  end
end
