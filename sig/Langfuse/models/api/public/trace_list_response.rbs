module Langfuse
  module Models
    module API
      module Public
        type trace_list_response =
          {
            data: ::Array[Langfuse::Models::API::Public::TraceListResponse::Data],
            meta: Langfuse::Models::API::Public::UtilsMetaResponse
          }

        class TraceListResponse < Langfuse::BaseModel
          attr_accessor data: ::Array[Langfuse::Models::API::Public::TraceListResponse::Data]

          attr_accessor meta: Langfuse::Models::API::Public::UtilsMetaResponse

          def initialize:
            (
              data: ::Array[Langfuse::Models::API::Public::TraceListResponse::Data],
              meta: Langfuse::Models::API::Public::UtilsMetaResponse
            ) -> void
            | (
              ?Langfuse::Models::API::Public::trace_list_response
              | Langfuse::BaseModel data
            ) -> void

          def to_hash: -> Langfuse::Models::API::Public::trace_list_response

          type data =
            {
              html_path: String,
              latency: Float,
              observations: ::Array[String],
              scores: ::Array[String],
              total_cost: Float
            }

          class Data < Langfuse::Models::API::Public::Trace
            attr_accessor html_path: String

            attr_accessor latency: Float

            attr_accessor observations: ::Array[String]

            attr_accessor scores: ::Array[String]

            attr_accessor total_cost: Float

            def initialize:
              (
                html_path: String,
                latency: Float,
                observations: ::Array[String],
                scores: ::Array[String],
                total_cost: Float
              ) -> void
              | (
