module Langfuse
  module Models
    module API
      module Public
        type utils_meta_response =
          {
            limit: Integer,
            page: Integer,
            total_items: Integer,
            total_pages: Integer
          }

        class UtilsMetaResponse < Langfuse::BaseModel
          attr_accessor limit: Integer

          attr_accessor page: Integer

          attr_accessor total_items: Integer

          attr_accessor total_pages: Integer

          def initialize:
            (
              limit: Integer,
              page: Integer,
              total_items: Integer,
              total_pages: Integer
            ) -> void
            | (
              ?Langfuse::Models::API::Public::utils_meta_response
              | Langfuse::BaseModel data
            ) -> void

          def to_hash: -> Langfuse::Models::API::Public::utils_meta_response
        end
      end
    end
  end
end
