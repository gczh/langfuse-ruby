module Langfuse
  module Models
    module API
      module Public
        module Datasets
          type run_delete_params =
            { dataset_name: String } & Langfuse::request_parameters

          class RunDeleteParams < Langfuse::BaseModel
            extend Langfuse::RequestParameters::Converter
            include Langfuse::RequestParameters

            attr_accessor dataset_name: String

            def initialize:
              (
                dataset_name: String,
                request_options: Langfuse::request_opts
              ) -> void
              | (
                ?Langfuse::Models::API::Public::Datasets::run_delete_params
                | Langfuse::BaseModel data
              ) -> void

            def to_hash: -> Langfuse::Models::API::Public::Datasets::run_delete_params
          end
        end
      end
    end
  end
end
