module Langfuse
  module Models
    module API
      module Public
        
        class DatasetRun = Datasets::DatasetRun

        module Datasets
          type dataset_run =
            {
              id: String,
              created_at: Time,
              dataset_id: String,
              dataset_name: String,
              name: String,
              updated_at: Time,
              description: String?,
              metadata: top
            }

          class DatasetRun < Langfuse::BaseModel
            attr_accessor id: String

            attr_accessor created_at: Time

            attr_accessor dataset_id: String

            attr_accessor dataset_name: String

            attr_accessor name: String

            attr_accessor updated_at: Time

            attr_accessor description: String?

            attr_reader metadata: top?

            def metadata=: (top) -> top

            def initialize:
              (
                id: String,
                created_at: Time,
                dataset_id: String,
                dataset_name: String,
                name: String,
                updated_at: Time,
                description: String?,
                metadata: top
              ) -> void
              | (
                ?Langfuse::Models::API::Public::Datasets::dataset_run
                | Langfuse::BaseModel data
              ) -> void

            def to_hash: -> Langfuse::Models::API::Public::Datasets::dataset_run
          end
        end
      end
    end
  end
end
