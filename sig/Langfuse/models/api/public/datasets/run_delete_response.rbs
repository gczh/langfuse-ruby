module Langfuse
  module Models
    module API
      module Public
        module Datasets
          type run_delete_response = { message: String }

          class RunDeleteResponse < Langfuse::BaseModel
            attr_accessor message: String

            def initialize:
              (message: String) -> void
              | (
                ?Langfuse::Models::API::Public::Datasets::run_delete_response
                | Langfuse::BaseModel data
              ) -> void

            def to_hash: -> Langfuse::Models::API::Public::Datasets::run_delete_response
          end
        end
      end
    end
  end
end
