module Langfuse
  module Models
    module API
      module Public
        type dataset_status = :ACTIVE | :ARCHIVED

        class DatasetStatus < Langfuse::Enum
          ACTIVE: :ACTIVE
          ARCHIVED: :ARCHIVED

          def self.values: -> ::Array[Langfuse::Models::API::Public::dataset_status]
        end
      end
    end
  end
end
